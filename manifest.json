{
  "manifest_version": 3,
  "name": "Nextcloud-Quick-Share",
  "version": "1.2.0",
  "description": "現在開いている Nextcloud のページからファイルをアップロードし、共有リンクを作成します。",

  "permissions": ["activeTab", "scripting", "storage"],

  "background": {
    "service_worker": "src/background.js"
  },

  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Nextcloud-Quick-Share",
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png",
      "48": "icon/icon-48.png",
      "128": "icon/icon-128.png"
    }
  }
}
